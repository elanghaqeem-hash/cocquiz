{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cocquiz",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-15",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "QUIZ_ROOM",
        "class_name": "QuizRoom"
      }
    ]
  },
  "exports": {
    "QuizRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
