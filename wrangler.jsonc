{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cocquiz",
  "main": "src/index.js",
  "compatibility_date": "2026-09-15",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "QUIZ_ROOM",
        "class_name": "QuizRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["QuizRoom"]
    }
  ]
}
